# Copy to .env and fill in. .env is git-ignored - never commit real secrets.
# Everything except the Telegram bot token is optional: a source whose secret is missing is skipped with one warning
# (send /sources to the bot to see what is on, off or skipped).

# --- Telegram bot (required to receive jobs) -----------------------------------------------
# 1. Talk to @BotFather -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Start the bot once and send /start: it replies with your chat id (setup mode). Put it here and restart.
TELEGRAM_OWNER_CHAT_ID=

# --- AI (optional) ---------------------------------------------------------------------------
# Draft proposals and read unknown job-alert e-mails. Without a key everything else works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Notifications ----------------------------------------------------------------------------
NOTIFY_MAX_PER_HOUR=6
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
QUIET_HOURS_ZONE=Asia/Baku

# --- Job sources that need a secret (optional) -----------------------------------------------
# Freelancer.com works without a token; with one the requests are authenticated.
FREELANCER_TOKEN=
# Himalayas: anonymous use is rate limited; a free key from himalayas.app/signup/developer raises the limit.
HIMALAYAS_API_KEY=
# hh.ru requires an identifying contact address in its HH-User-Agent header (FreelanceJobRadar/1.0 (<email>)).
# hh.ru is skipped while this is empty - put YOUR email here.
HH_CONTACT_EMAIL=
# Freelancehunt API v2 token (freelancehunt.com -> settings -> API). Skipped while empty.
FREELANCEHUNT_TOKEN=

# --- Email alerts over IMAP (Upwork, Djinni, LinkedIn, Guru, PeoplePerHour, Kwork, boss.az ...) -
# Set EMAIL_ALERTS_ENABLED=true, then fill in the Gmail address and an App Password (NOT your normal password).
# Only the label named MAIL_FOLDER is read - see README "Set up email alerts".
EMAIL_ALERTS_ENABLED=false
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FOLDER=JobAlerts

# --- Telegram channels via the client API (optional, reads public channels as YOU) ------------
# Get api id/hash at https://my.telegram.org -> API development tools. Phone in international format.
# One-time login: docker compose run --rm -it app --telegram-login   Channels go in config/channels.yml.
TELEGRAM_CHANNELS_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# --- Database (docker compose uses this for both postgres and the app) -----------------------
POSTGRES_PASSWORD=change-me
