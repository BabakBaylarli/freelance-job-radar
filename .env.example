# Copy to .env and fill in. .env is git-ignored - never commit real secrets.

# --- Telegram (required to receive jobs) ---------------------------------------------------
# 1. Talk to @BotFather -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=
# 2. Start the bot once and send /start: it replies with your chat id (setup mode). Put it here and restart.
TELEGRAM_OWNER_CHAT_ID=

# --- AI proposals (optional) ------------------------------------------------------------------
# Without a key everything works except the "Draft proposal" button, which explains that AI is off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Notifications ----------------------------------------------------------------------------
NOTIFY_MAX_PER_HOUR=6
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
QUIET_HOURS_ZONE=Asia/Baku

# --- Database (docker compose uses these for both postgres and the app) -----------------------
POSTGRES_PASSWORD=change-me
